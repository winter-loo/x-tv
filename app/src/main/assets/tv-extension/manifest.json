{
  "manifest_version": 2,
  "name": "TV X Extension",
  "version": "1.6.4",
  "description": "Remote-first TV navigation and CSS adapter for X",
  "browser_specific_settings": {
    "gecko": {
      "id": "tv-extension@deeloo.cn"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "tabs",
    "<all_urls>",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": [
      "sites/x/like-observer.js",
      "runtime/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "match_about_blank": true,
      "all_frames": false,
      "js": [
        "sites/x/api-metadata.js",
        "sites/x/loading-metrics.js",
        "sites/x/login-stage.js",
        "sites/x/bootstrap.js",
        "runtime/navigation-runtime.js",
        "sites/x/post-identity.js",
        "sites/x/reading.js",
        "sites/x/detail.js",
        "sites/x/card.js",
        "sites/x/actions.js",
        "sites/x/media.js",
        "sites/x/adapter.js",
        "runtime/adapter-registry.js",
        "runtime/content.js"
      ],
      "run_at": "document_start",
      "css": [
        "sites/x/bootstrap.css",
        "sites/x/card.css",
        "sites/x/media.css"
      ]
    }
  ],
  "web_accessible_resources": [
    "sites/x/tv.css",
    "sites/x/reading.css",
    "sites/x/detail.css",
    "sites/x/actions.css",
    "sites/x/card.css",
    "sites/x/icons/*.svg",
    "sites/x/media.css"
  ]
}
