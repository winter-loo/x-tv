+package cn.deeloo.tvxbrowser;
+
+import android.os.SystemClock;
+import android.util.Log;
+import org.json.JSONObject;
+import org.mozilla.geckoview.GeckoSession;
+import org.mozilla.geckoview.WebExtension;
+import java.util.IdentityHashMap;
+import java.util.Map;
+
+/** Isolated research instrumentation. Never a production bridge. */
+public final class RfcProbe {
+    private static final Map<GeckoSession, WebExtension.Port> ports = new IdentityHashMap<>();
+    private static int sequence;
+    public static boolean silent;
+    public static String id(Object o) { return o == null ? "null" : Integer.toHexString(System.identityHashCode(o)); }
+    public static void log(String event, GeckoSession session, String detail) {
+        Log.e("RfcProbe", "t=" + SystemClock.elapsedRealtime() + " event=" + event + " session=" + id(session) + " " + detail);
+    }
+    public static void attach(WebExtension extension, GeckoSession session) {
+        log("delegate",session,"");
+        session.getWebExtensionController().setMessageDelegate(extension,new WebExtension.MessageDelegate() {
+            @Override public void onConnect(WebExtension.Port port) {
+                int connection=++sequence;
+                GeckoSession owner=port.sender.session;
+                ports.put(owner,port);
+                log("connect",owner,"connection="+connection+" port="+id(port)+" env="+port.sender.environmentType+" top="+port.sender.isTopLevel());
+                port.setDelegate(new WebExtension.PortDelegate() {
+                    @Override public void onPortMessage(Object message, WebExtension.Port source) {
+                        if (!(message instanceof JSONObject)) return;
+                        JSONObject j=(JSONObject)message;
+                        log("message",owner,"connection="+connection+" port="+id(source)+" data="+j);
+                        if (silent) return;
+                        try {
+                            JSONObject ack=new JSONObject();
+                            ack.put("event","probe_ack"); ack.put("connection",connection);
+                            ack.put("echo",j.optString("event")); ack.put("documentId",j.optString("documentId"));
+                            source.postMessage(ack);
+                        } catch(Exception e) { log("send_error",owner,e.getClass().getSimpleName()); }
+                    }
+                    @Override public void onDisconnect(WebExtension.Port source) {
+                        log("disconnect",owner,"connection="+connection+" port="+id(source)+" current="+(ports.get(owner)==source));
+                        if(ports.get(owner)==source) ports.remove(owner);
+                    }
+                });
+            }
+        },"rfc_probe");
+    }
+    public static void command(GeckoSession session, String op) {
+        WebExtension.Port port=ports.get(session);
+        log("command",session,"op="+op+" port="+id(port));
+        if(port==null)return;
+        try { JSONObject j=new JSONObject();j.put("command",op);port.postMessage(j); }
+        catch(Exception e) {log("command_error",session,e.getClass().getSimpleName());}
+    }
+}
