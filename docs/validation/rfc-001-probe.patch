@@ -0,0 +1,46 @@
+(() => {
+  const injected = Number(document.documentElement?.dataset.rfcInject || 0) + 1;
+  const mark = () => { if (document.documentElement) document.documentElement.dataset.rfcInject = String(injected); };
+  mark();
+  if (!document.documentElement) new MutationObserver((_,o)=>{mark();if(document.documentElement)o.disconnect();}).observe(document,{childList:true});
+  if (window.__rfcProbeInstalled) { console.error('[RFC] duplicate_injection'); return; }
+  window.__rfcProbeInstalled=true;
+  let documentId;
+  try { documentId=browser.runtime.getDocumentId(window); } catch(e) { documentId='unavailable:'+e.name; }
+  const origin=performance.timeOrigin;
+  let port,connected=0;
+  const activePorts=[];
+  const log=(event,extra={})=>{
+    const row={event,documentId,origin,at:performance.now(),host:location.hostname,kind:location.protocol==='data:'?'data':location.pathname==='/home'?'home':location.pathname.includes('/status/')?'detail':'other',hidden:document.hidden,readyState:document.readyState,...extra};
+    console.error('[RFC] content '+JSON.stringify(row));
+    if(document.documentElement)document.documentElement.dataset.rfcDocument=documentId;
+    if(port)try{port.postMessage(row);}catch(e){console.error('[RFC] post_error '+e.name);}
+  };
+  function connect() {
+    try {
+      port=browser.runtime.connectNative('rfc_probe');activePorts.push(port);connected++;
+      const source=port;
+      source.onMessage.addListener(message=>{
+        if(message.command==='reconnect') connect();
+        else if(message.command==='old_disconnect'){if(activePorts.length>1)activePorts[activePorts.length-2].disconnect();}
+        else if(message.command==='snapshot') log('snapshot',{connections:connected,bootCovered:document.documentElement.classList.contains('tv-x-boot'),hostReady:!!window.TvXNativeHost});
+        else if(message.command==='late_on_pagehide') window.__rfcLate=true;
+        else if(message.command==='query_current') {
+          browser.runtime.sendMessage({event:'rfc_doc_query',documentId}).then(result=>log('query_result',{result})).catch(e=>log('query_error',{error:e.name}));
+        } else if(message.event==='probe_ack'){
+          if(document.documentElement)document.documentElement.dataset.rfcAck=String(message.connection);
+        }
+      });
+      source.onDisconnect.addListener(()=>{console.error('[RFC] port_disconnect '+JSON.stringify({documentId,origin,at:performance.now(),error:source.error?.message||null,current:source===port}));if(source===port)port=null;});
+      log('connected',{connections:connected});
+    } catch(e) {log('connect_error',{error:e.name});}
+  }
+  connect();
+  for(const event of ['DOMContentLoaded','load','pageshow','pagehide','visibilitychange']){
+    addEventListener(event,e=>{
+      log(event,{persisted:!!e.persisted});
+      if(event==='pagehide'&&window.__rfcLate)connect();
+    });
+  }
+  for(const event of ['keydown','keyup'])addEventListener(event,e=>log(event,{key:e.key,code:e.code,trusted:e.isTrusted,repeat:e.repeat}),true);
+})();
